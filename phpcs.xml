<?xml version="1.0"?>
<ruleset name="CHIP FluentForms Gateway Charges">
	<description>PHPCS ruleset for the CHIP FluentForms Gateway Charges plugin.</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Only scan PHP files -->
	<arg name="extensions" value="php"/>

	<!-- Exclude paths -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<!-- Use WordPress coding standards -->
	<rule ref="WordPress">
	</rule>

	<!-- Set minimum supported PHP version -->
	<config name="minimum_supported_wp_version" value="6.1"/>
	<config name="testVersion" value="7.4-"/>

	<!-- Text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="cff_gc"/>
			</property>
		</properties>
	</rule>

	<!--
		PSR2_Classes_PropertyDeclaration: the settings framework uses the
		WordPress pseudo-singleton pattern with $_instance. Renaming it would
		change the pattern shared by every CHIP plugin's settings framework.
		Same exclusion as chip-for-fluent-forms/phpcs.xml.
	-->
	<rule ref="PSR2.Classes.PropertyDeclaration">
		<exclude name="PSR2.Classes.PropertyDeclaration.Underscore"/>
	</rule>

	<!--
		The main plugin file intentionally holds both the settings bootstrap and
		the standalone charge-calculation functions (cff_minimum_fee(),
		cff_variable_rate(), cff_inject_gateway_charges() and others) that are
		hooked to the Fluent Forms filters. Splitting them would change the
		plugin entry point and the function names the filters resolve.
	-->
	<rule ref="Universal.Files.SeparateFunctionsFromOO">
		<exclude-pattern>chip-fluent-forms-gateway-charges.php</exclude-pattern>
	</rule>

	<!--
		WordPress resolves the plugin from this exact file name, so it cannot be
		renamed to match a class. Same single exclusion as
		chip-for-fluent-forms/phpcs.xml.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>chip-fluent-forms-gateway-charges.php</exclude-pattern>
	</rule>

	<!--
		The settings framework keeps the createOptions()/createSection() method
		names it inherited from the Codestar Framework it replaced. Those names
		are the call site contract in includes/admin/global-settings.php and
		includes/admin/form-settings.php, so renaming them would be churn across
		every settings file for no behavioural gain.
	-->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>includes/class-chip-ff-settings.php</exclude-pattern>
	</rule>

	<!--
		The hook functions in the main plugin file receive the form, submission,
		transaction and payment objects positionally from the Fluent Forms
		filters (ff_chip_create_purchase_params, ff_chip_after_purchase_create).
		Their signatures cannot change, so an argument a given callback does not
		read still has to stay in place.
	-->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>chip-fluent-forms-gateway-charges.php</exclude-pattern>
	</rule>
</ruleset>
